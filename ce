#!/usr/bin/env bash
# Lancia il compilatore Ce++ (https://github.com/Duffionis/Ce-), scaricandolo la prima volta.
#   ./ce esegui src/principale.ce
# Per usare una copia del compilatore che hai gia': CE_COMPILATORE=/percorso/di/Ce- ./ce esegui ...
set -e
QUI="$(cd "$(dirname "$0")" && pwd)"
COMP="$QUI/.compilatore"
PIN="v0.2"   # versione del compilatore con cui questo programma e' stato provato
if [ -n "$CE_COMPILATORE" ]; then
  ln -sfn "$CE_COMPILATORE" "$COMP"
else
  [ -f "$COMP/ce-lang/ce.py" ] || git clone -q https://github.com/Duffionis/Ce- "$COMP"
  if [ "$(git -C "$COMP" rev-parse HEAD)" != "$(git -C "$COMP" rev-parse -q --verify "$PIN^{commit}" || echo -)" ]; then
    git -C "$COMP" fetch -q --tags origin
    git -C "$COMP" checkout -q "$PIN"
  fi
fi
exec python3 "$COMP/ce-lang/ce.py" "$@"
